  {
    "test_id": "rob-01-port-nonnumeric-string",
    "target_rule_source": "semantic_oracle",
    "rule_id": "11111111-0000-4000-8000-000000000006",
    "rule_file": "sem_06_numeric_compare.yml",
    "schema_violation": "dst_endpoint.port is string 'not-an-integer' instead of OCSF port_t (integer_t)",
    "case": {
      "test_event_id": "rob-01-port-nonnumeric-string",
      "ocsf_version": "1.4.0",
      "strict_ocsf_v140": false,
      "category_uid": 4,
      "class_uid": 4001,
      "activity_id": 1,
      "ocsf_fields": {
        "dst_endpoint": {
          "ip": "198.51.100.20",
          "port": "not-an-integer"
        }
      },
      "expected_match": false,
      "expected_reason": "Malformed non-numeric port string is safely guarded before CAST(... AS NUMERIC), returning NO_MATCH without SQL error."
    }
  },
